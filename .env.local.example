# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real secrets to GitHub.

# Get this from MongoDB Atlas (free tier): Database > Connect > Drivers
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/casevault

# Any long random string. You can generate one by running this in your
# terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
